# ═══════════════════════════════════════════════════════════════
# AetherLearn AI — Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ─── OpenAI API ─────────────────────────────────────────────────
# Get your key from: https://platform.openai.com/api-keys
# Leave as placeholder to run in mock/demo mode (no real AI calls)
OPENAI_API_KEY=your_openai_api_key_here

# ─── JWT Authentication ─────────────────────────────────────────
# Use a long, random string. Change this in production!
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ─── Server ─────────────────────────────────────────────────────
PORT=3001

# ─── Database ───────────────────────────────────────────────────
# Path to the data directory (NeDB stores .db files here)
DB_PATH=./data

# ─── Admin Seed Account ─────────────────────────────────────────
# Used only for initial database seeding
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin123

# ─── Code Execution Limits ──────────────────────────────────────
# Maximum characters allowed in a code submission
MAX_CODE_LENGTH=5000

# Maximum execution time in milliseconds (for future real sandbox)
CODE_TIMEOUT_MS=5000

# Comma-separated list of allowed programming languages
SUPPORTED_LANGUAGES=python,javascript
